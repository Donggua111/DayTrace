    "typingActivity.explanation.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayTrace measures typing activity locally and never stores what you type. “Typed Characters” is an estimate based on keyboard events. Backspace, Delete, Return, Tab, and control keys are not counted. Pasted text, final characters committed by Chinese IMEs, and app-generated text are not currently counted."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DayTrace 仅在本地统计键盘输入活动，不保存你的输入内容。 “输入字符”是基于键盘事件得到的估算值。退格、删除、回车、Tab 和功能键不会计入。粘贴内容、中文输入法最终提交的汉字，以及应用自动生成的文本当前不会计入。"
          }
        }
      }
    },
