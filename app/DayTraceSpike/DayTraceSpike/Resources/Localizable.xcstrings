    "typingActivity.explanation.action" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About typing activity"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
